<?xml version="1.0"?>
<robot name="my_best_model" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Variant 6: six main links, four R joints and two C wheel joints. -->
  <!-- Overall wheelbase dimensions: 0.20 x 0.16 x 0.09 m. -->
  <xacro:property name="body_length" value="0.20"/>
  <xacro:property name="body_width" value="0.16"/>
  <xacro:property name="body_height" value="0.09"/>
  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_thickness" value="0.02"/>
  <xacro:property name="arm_1_length" value="0.09"/>
  <xacro:property name="arm_2_length" value="0.08"/>
  <xacro:property name="arm_3_length" value="0.07"/>
  <xacro:property name="arm_4_length" value="0.06"/>

  <material name="blue"><color rgba="0.1 0.4 0.9 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.1 1"/></material>
  <material name="green"><color rgba="0.1 0.8 0.4 1"/></material>
  <material name="gray"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.055"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.055"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="mount_link">
    <visual>
      <origin xyz="0 0 0.015"/>
      <geometry><cylinder radius="0.025" length="0.03"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="base_to_mount" type="fixed">
    <parent link="base_link"/>
    <child link="mount_link"/>
    <origin xyz="0 0 0.09"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="-0.06 ${y} 0.04"/>
      <axis xyz="0 1 0"/>
      <limit effort="5.0" velocity="10.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left" y="0.07"/>
  <xacro:wheel side="right" y="-0.07"/>

  <xacro:macro name="arm_segment" params="name length width color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${float(length) / 2.0}"/>
        <geometry><box size="${width} ${width} ${length}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${float(length) / 2.0}"/>
        <geometry><box size="${width} ${width} ${length}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:arm_segment name="arm_link_1" length="${arm_1_length}" width="0.030" color="orange"/>
  <xacro:arm_segment name="arm_link_2" length="${arm_2_length}" width="0.026" color="green"/>
  <xacro:arm_segment name="arm_link_3" length="${arm_3_length}" width="0.023" color="orange"/>
  <xacro:arm_segment name="arm_link_4" length="${arm_4_length}" width="0.020" color="green"/>

  <joint name="joint_1" type="revolute">
    <parent link="mount_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0.03"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="1.5"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0 0 ${arm_1_length}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5.0" velocity="1.5"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="arm_link_2"/>
    <child link="arm_link_3"/>
    <origin xyz="0 0 ${arm_2_length}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="5.0" velocity="1.5"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="arm_link_3"/>
    <child link="arm_link_4"/>
    <origin xyz="0 0 ${arm_3_length}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0.015"/>
      <geometry>
        <box size="0.025 0.025 0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="arm_to_tool" type="fixed">
    <parent link="arm_link_4"/>
    <child link="tool_link"/>
    <origin xyz="0 0 ${arm_4_length}"/>
  </joint>

</robot>
